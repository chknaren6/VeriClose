VERICLOSE_ENVIRONMENT=development
VERICLOSE_HOST=0.0.0.0
VERICLOSE_PORT=8000
VERICLOSE_DATA_DIR=.data
VERICLOSE_DATABASE_PATH=.data/vericlose.duckdb
VERICLOSE_STATIC_DIR=apps/api/app/static
VERICLOSE_POLICY_PATH=config/policies/razorpay_inr_v1.yaml
VERICLOSE_UPLOAD_MAX_BYTES=10485760
VERICLOSE_DEMO_MODE=true
VERICLOSE_DETERMINISTIC_SEED=42
VERICLOSE_BUILD_COMMIT=development
VERICLOSE_RULE_VERSION=segment4-v1
VERICLOSE_POLICY_VERSION=razorpay_inr_v1@1.0.0

# Optional. Deterministic reconciliation must work when it is absent.
# VERICLOSE_MODEL_API_KEY=
